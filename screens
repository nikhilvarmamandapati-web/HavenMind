                padding: const EdgeInsets.all(16),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text('Send a Note to ${current.requesterName}:', style: const TextStyle(fontWeight: FontWeight.bold)),
