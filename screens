class VentVaultScreen extends StatefulWidget {
  const VentVaultScreen({super.key});

  @override
  State<VentVaultScreen> createState() => _VentVaultScreenState();
}

class _VentVaultScreenState extends State<VentVaultScreen> {
  final _textController = TextEditingController();
  double _distressWeight = 6;
  List<DistortionResult>? _detectedTraps;
  bool _isDissolving = false;

  void _burnAndDisappear() async {
    if (_textController.text.trim().isEmpty) return;

    setState(() {
      _isDissolving = true;
    });

    await Future.delayed(const Duration(milliseconds: 1400));

    setState(() {
      _textController.clear();
      _detectedTraps = null;
      _isDissolving = false;
    });

    if (mounted) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('✨ Your words have burned into smoke. Nothing was saved or stored.'),
          backgroundColor: Color(0xFF1B4332),
        ),
      );
    }
  }

  void _untangleThoughts() {
    if (_textController.text.trim().isEmpty) return;
    final results = CognitiveReframerService.analyzeThought(_textController.text);
    setState(() {
      _detectedTraps = results;
    });
  }

  @override
  void dispose() {
    _textController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Private Venting'),
        elevation: 0,
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            // Explanatory card
            Card(
              color: const Color(0xFFFEF3C7),
              child: Padding(
                padding: const EdgeInsets.all(14),
                child: Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: const [
                    Icon(Icons.info_outline, color: Color(0xFFB45309)),
                    SizedBox(width: 10),
                    Expanded(
                      child: Text(
                        'Write down whatever is bothering you in total privacy. You can burn it into smoke so it leaves your mind, or tap "Untangle Thoughts" for kind perspective.',
                        style: TextStyle(fontSize: 12, color: Color(0xFF78350F)),
                      ),
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 16),

            // Emotional weight slider
            Card(
              child: Padding(
                padding: const EdgeInsets.all(16),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceBetween,
                      children: [
                        const Text('How heavy does this feel?', style: TextStyle(fontWeight: FontWeight.w600)),
                        Text('${_distressWeight.toInt()}/10', style: const TextStyle(fontWeight: FontWeight.bold)),
                      ],
                    ),
                    Slider(
                      value: _distressWeight,
                      min: 1,
                      max: 10,
                      divisions: 9,
                      activeColor: const Color(0xFF2D6A4F),
                      onChanged: (val) => setState(() => _distressWeight = val),
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 16),

            // Text Input Box
            AnimatedOpacity(
              opacity: _isDissolving ? 0.0 : 1.0,
              duration: const Duration(milliseconds: 1000),
              child: TextField(
                controller: _textController,
                maxLines: 6,
                decoration: InputDecoration(
                  hintText: 'Type your raw feelings here... (e.g. "I feel completely overwhelmed and I messed up...")',
                  filled: true,
                  fillColor: Colors.white,
                  border: OutlineInputBorder(
                    borderRadius: BorderRadius.circular(20),
                    borderSide: const BorderSide(color: Color(0xFFE5E7EB)),
                  ),
                ),
              ),
            ),
            const SizedBox(height: 16),

            // Action Buttons
            Row(
              children: [
                Expanded(
                  child: OutlinedButton.icon(
                    style: OutlinedButton.styleFrom(
                      foregroundColor: Colors.red.shade800,
                      side: BorderSide(color: Colors.red.shade200),
                      padding: const EdgeInsets.symmetric(vertical: 14),
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
                    ),
                    onPressed: _burnAndDisappear,
                    icon: const Icon(Icons.local_fire_department),
                    label: const Text('Burn & Let Go', style: TextStyle(fontSize: 13, fontWeight: FontWeight.bold)),
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: FilledButton.icon(
                    style: FilledButton.styleFrom(
                      backgroundColor: const Color(0xFF2D6A4F),
                      padding: const EdgeInsets.symmetric(vertical: 14),
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
                    ),
                    onPressed: _untangleThoughts,
                    icon: const Icon(Icons.auto_awesome),
                    label: const Text('Untangle Thoughts', style: TextStyle(fontSize: 13, fontWeight: FontWeight.bold)),
                  ),
                ),
              ],
            ),

            // Advice Results
            if (_detectedTraps != null) ...[
              const SizedBox(height: 24),
              const Text('A Kinder Way to Look at This:', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
              const SizedBox(height: 10),
              if (_detectedTraps!.isEmpty)
                Card(
                  color: const Color(0xFFECFDF5),
                  child: const Padding(
                    padding: EdgeInsets.all(16),
                    child: Text('Your feelings make sense. Take a slow breath; you are doing your best with what you have today.'),
                  ),
                )
              else
                for (final trap in _detectedTraps!)
                  Card(
                    margin: const EdgeInsets.only(bottom: 12),
                    child: Padding(
                      padding: const EdgeInsets.all(16),
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Row(
                            children: [
                              const Icon(Icons.psychology, color: Color(0xFF2D6A4F), size: 20),
                              const SizedBox(width: 8),
                              Text(trap.name, style: const TextStyle(fontWeight: FontWeight.bold)),
                            ],
                          ),
                          const SizedBox(height: 6),
                          Text(trap.explanation, style: const TextStyle(fontSize: 12, color: Colors.black54)),
                          const SizedBox(height: 10),
                          Container(
                            padding: const EdgeInsets.all(12),
                            decoration: BoxDecoration(
                              color: const Color(0xFFECFDF5),
                              borderRadius: BorderRadius.circular(12),
                            ),
                            child: Text('💡 ${trap.gentleReframe}', style: const TextStyle(fontSize: 13, color: Color(0xFF065F46))),
                          ),
                        ],
                      ),
                    ),
                  ),
            ],
          ],
        ),
      ),
    );
  }
}

