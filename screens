}

class _KindnessScreenState extends ConsumerState<KindnessScreen> {
  final _noteController = TextEditingController();
  int _selectedBeaconIndex = 0;

  void _sendNote() {
    if (_noteController.text.trim().isEmpty) return;

    final beacons = ref.read(kindnessBeaconsProvider);
    final target = beacons[_selectedBeaconIndex];

    target.notes.insert(0, _noteController.text.trim());
    ref.read(kindnessBeaconsProvider.notifier).state = [...beacons];

    _noteController.clear();
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(content: Text('💌 Kind note sent! Thank you for spreading warmth.')),
    );
  }

  @override
  void dispose() {
    _noteController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final beacons = ref.watch(kindnessBeaconsProvider);
    final current = beacons[_selectedBeaconIndex];

    return Scaffold(
      appBar: AppBar(
        title: const Text('Kindness Cards'),
        elevation: 0,
