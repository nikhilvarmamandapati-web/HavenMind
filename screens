      'sense': 'TOUCH',
      'prompt': 'Acknowledge 4 things you can physically feel.',
      'hint': 'Your feet on the ground, fabric of your shirt, cool air on your skin.',
      'color': Colors.amber,
    },
    {
      'count': '3',
      'sense': 'HEAR',
      'prompt': 'Acknowledge 3 things you can hear right now.',
      'hint': 'Traffic, hum of a refrigerator, sound of your own steady breath.',
      'color': Colors.blue,
