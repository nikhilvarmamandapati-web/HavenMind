    if (breathingPhase === 'Hold') return 'scale-125 transition-none';
    if (breathingPhase === 'Exhale') return 'scale-90 transition-transform duration-[4000ms] ease-in';
    return 'scale-95 transition-transform duration-[4000ms]';
