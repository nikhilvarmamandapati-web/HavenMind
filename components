    with SingleTickerProviderStateMixin {
  late AnimationController _controller;
  late Animation<double> _scaleAnimation;
  String _phaseName = 'Inhale';
  String _phaseHint = 'Breathe in slowly through your nose...';
  int _secondsRemaining = 4;
  int _hugsSentCount = 142;

  @override
  void initState() {
    super.initState();
    _controller = AnimationController(
      vsync: this,
      duration: const Duration(seconds: 16),
    )..repeat();

    _scaleAnimation = TweenSequence<double>([
      TweenSequenceItem(tween: Tween(begin: 0.85, end: 1.25).chain(CurveTween(curve: Curves.easeOutCubic)), weight: 25),
