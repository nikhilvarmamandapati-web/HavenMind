          />

          {isDissolving && (
            <div className="absolute inset-0 flex items-center justify-center bg-stone-900/10 backdrop-blur-xs rounded-2xl pointer-events-none">
              <span className="text-xs font-semibold text-stone-700 flex items-center gap-2">
                <Sparkles className="w-4 h-4 text-emerald-600 animate-spin" />
                <span>Burning away your worry into smoke...</span>
              </span>
            </div>
          )}
        </div>

        {/* Quick Example Prompts */}
        {!ventText && (
          <div className="space-y-1.5">
            <span className="text-xs text-stone-500">Not sure what to write? Click an example to test:</span>
            <div className="flex flex-wrap gap-2">
              {quickPrompts.map((qp, i) => (
                <button
                  key={i}
                  onClick={() => setVentText(qp)}
                  className="text-xs text-stone-700 hover:text-stone-950 bg-stone-100 hover:bg-stone-200 px-3 py-1.5 rounded-lg transition-colors text-left"
                >
                  "{qp}"
                </button>
              ))}
            </div>
          </div>
        )}

        {/* Big Action Buttons */}
        <div className="pt-3 border-t border-stone-100 flex flex-wrap items-center justify-between gap-3">
          <button
            onClick={handleDissolve}
            disabled={!ventText.trim() || isDissolving}
            className="px-4 py-2.5 rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-800 text-xs font-semibold transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1.5"
          >
            <Flame className="w-4 h-4 text-rose-600" />
            <span>Option A: Burn & Disappear (Erase Forever)</span>
          </button>

          <button
            onClick={handleAnalyze}
            disabled={!ventText.trim() || isDissolving}
            className="px-5 py-2.5 rounded-xl bg-emerald-800 hover:bg-emerald-700 text-white text-xs font-semibold transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1.5 shadow-sm"
          >
            <Sparkles className="w-4 h-4 text-emerald-300" />
            <span>Option B: Untangle Thoughts (Get Kind Advice)</span>
          </button>
        </div>
      </div>

      {/* Results Box */}
      {analysis && (
        <div className="p-6 rounded-3xl bg-emerald-50/70 border border-emerald-200 space-y-5 animate-in fade-in">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-2">
              <ShieldCheck className="w-5 h-5 text-emerald-800" />
              <h3 className="text-base font-bold text-stone-900">Gentle Advice & New Perspective</h3>
            </div>
            <span className="text-xs text-emerald-900 font-semibold bg-emerald-100 px-2.5 py-1 rounded-full">
              {analysis.distortions.length === 0
                ? 'Healthy thinking'
                : `${analysis.distortions.length} common mental trap${analysis.distortions.length > 1 ? 's' : ''} spotted`}
            </span>
          </div>

          {/* Core Reframe */}
          <div className="p-4 rounded-2xl bg-white border border-emerald-200 shadow-xs space-y-1">
            <div className="text-xs font-bold text-emerald-800 uppercase tracking-wider">
              A kinder way to look at this:
            </div>
            <p className="text-sm text-stone-800 leading-relaxed font-medium">
              {analysis.reframeSummary}
            </p>
          </div>

          {/* Traps Breakdown */}
          {analysis.distortions.length > 0 && (
            <div className="space-y-2">
              <span className="text-xs font-bold text-stone-700">
                What your anxiety might be doing:
              </span>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                {analysis.distortions.map((d, idx) => (
                  <div
                    key={idx}
                    className="p-3.5 rounded-xl bg-white border border-emerald-100 space-y-1.5"
                  >
                    <div className="text-xs font-bold text-stone-900">
                      Trap: {d.name}
                    </div>
                    <p className="text-xs text-stone-600">{d.explanation}</p>
                    <div className="p-2.5 rounded-lg bg-emerald-50/80 text-xs text-emerald-950 leading-relaxed font-medium">
                      💡 <strong>Friendly reminder:</strong> {d.gentleReframe}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Optional Sharing */}
          <div className="pt-4 border-t border-emerald-200 space-y-3">
            <div>
              <h4 className="text-sm font-bold text-stone-900">
                Option C: Share with others anonymously?
              </h4>
              <p className="text-xs text-stone-600">
                If you want other people to read this and send you friendly support, choose what kind of help you want:
              </p>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <label className="text-xs font-medium text-stone-700 flex flex-col gap-1">
