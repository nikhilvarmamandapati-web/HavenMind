import { useState } from 'react';
import { Feather, Flame, Sparkles, Check, ArrowRight, ShieldCheck, Heart, HelpCircle, RefreshCw } from 'lucide-react';
import { analyzeVentThought } from '../services/reframerService';
import { soundEngine } from '../services/soundEngine';
import { CognitiveDistortionMatch, PostIntent } from '../types';

interface VentVaultProps {
  onPublishToFeed: (postData: {
    title: string;
    content: string;
    intent: PostIntent;
    isSensitive: boolean;
  }) => void;
}

export function VentVault({ onPublishToFeed }: VentVaultProps) {
  const [ventText, setVentText] = useState<string>('');
  const [distressIntensity, setDistressIntensity] = useState<number>(6);
  const [analysis, setAnalysis] = useState<{
    distortions: CognitiveDistortionMatch[];
    reframeSummary: string;
  } | null>(null);
  const [isDissolving, setIsDissolving] = useState<boolean>(false);
  const [hasDissolved, setHasDissolved] = useState<boolean>(false);
  const [selectedIntent, setSelectedIntent] = useState<PostIntent>('Needs Gentle Listening');
  const [markSensitive, setMarkSensitive] = useState<boolean>(false);
  const [publishSuccess, setPublishSuccess] = useState<boolean>(false);

  const handleAnalyze = () => {
    if (!ventText.trim()) return;
    const result = analyzeVentThought(ventText);
    setAnalysis(result);
    soundEngine.playSingingBowl(480, 2);
  };

  const handleDissolve = () => {
    if (!ventText.trim()) return;
    setIsDissolving(true);
    soundEngine.playSingingBowl(380, 3.5);

    setTimeout(() => {
      setVentText('');
      setAnalysis(null);
      setIsDissolving(false);
      setHasDissolved(true);
      setTimeout(() => setHasDissolved(false), 5000);
    }, 1800);
  };

  const handlePublish = () => {
    if (!ventText.trim()) return;
    onPublishToFeed({
      title: 'Anonymous Vent',
      content: ventText.trim(),
      intent: selectedIntent,
      isSensitive: markSensitive || distressIntensity >= 8,
    });
    setPublishSuccess(true);
    soundEngine.playPebbleDrop();
    setVentText('');
    setAnalysis(null);
    setTimeout(() => setPublishSuccess(false), 4000);
  };

  const quickPrompts = [
    'I feel like I am failing at everything and letting people down...',
    'Everything feels completely overwhelming and I cannot handle tomorrow...',
    'I feel like I should have achieved so much more by now...',
  ];

  return (
    <div className="space-y-6">
      {/* Friendly Guide Card at Top */}
      <div className="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-stone-800 flex items-start gap-3">
        <HelpCircle className="w-5 h-5 text-amber-700 shrink-0 mt-0.5" />
        <div className="space-y-1">
          <h4 className="text-sm font-bold text-amber-950">How Private Venting works:</h4>
          <p className="text-xs text-amber-900 leading-relaxed">
            Write down whatever is bothering you—it is completely private on your device. Then choose:
          </p>
          <ul className="text-xs text-amber-950/90 list-disc list-inside space-y-0.5">
            <li><strong>Burn & Let Go:</strong> Watches your words disappear into smoke with a calm chime so you feel lighter.</li>
            <li><strong>Untangle Thoughts:</strong> Gives you gentle advice showing how your stressed brain might be tricking you.</li>
            <li><strong>Share Anonymously:</strong> Send it to the community if you want friendly people to listen to you.</li>
          </ul>
        </div>
      </div>

      {/* Header */}
      <div className="pb-2 border-b border-stone-200">
        <span className="text-xs font-semibold uppercase tracking-wider text-emerald-800">
          Private Journaling & Relief
        </span>
        <h1 className="text-2xl sm:text-3xl font-bold text-stone-900 mt-1">
          Private Venting & Thought Untangler
        </h1>
        <p className="text-xs sm:text-sm text-stone-600 mt-1 max-w-2xl">
          Get heavy thoughts out of your head without fear of judgment. Nothing is ever saved unless you choose to share.
        </p>
      </div>

      {/* Success Notifications */}
      {hasDissolved && (
        <div className="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 flex items-center gap-3 animate-in fade-in">
          <Sparkles className="w-5 h-5 text-emerald-700 shrink-0" />
          <p className="text-xs sm:text-sm font-medium">
            Your words are completely gone. Take a deep, gentle breath and let your shoulders drop. You are safe.
          </p>
        </div>
      )}

      {publishSuccess && (
        <div className="p-4 rounded-2xl bg-teal-50 border border-teal-200 text-teal-900 flex items-center gap-3 animate-in fade-in">
          <Check className="w-5 h-5 text-teal-700 shrink-0" />
          <p className="text-xs sm:text-sm font-medium">
            Posted anonymously to Stories & Community. Others can now send you support.
          </p>
        </div>
      )}

      {/* Writing Box */}
      <div className="p-6 rounded-3xl bg-white border border-stone-200 shadow-xs space-y-5">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <Feather className="w-4 h-4 text-emerald-700" />
            <span className="text-sm font-bold text-stone-900">Step 1: Write What's on Your Mind</span>
            <span className="text-xs text-emerald-700 font-medium">· 100% Private</span>
          </div>

          {/* Distress intensity slider */}
          <div className="flex items-center gap-2 bg-stone-50 px-3 py-1.5 rounded-xl border border-stone-200">
            <span className="text-xs text-stone-600 font-medium">How heavy does it feel?</span>
            <input
              type="range"
              min="1"
              max="10"
              value={distressIntensity}
              onChange={(e) => setDistressIntensity(Number(e.target.value))}
              className="w-24 accent-emerald-700 cursor-pointer"
            />
            <span className="text-xs font-mono font-bold text-stone-800 tabular-nums">
              {distressIntensity}/10
            </span>
          </div>
        </div>

        {/* Text Area with Dissolve Animation */}
        <div className="relative">
          <textarea
            value={ventText}
            onChange={(e) => {
              setVentText(e.target.value);
              if (analysis) setAnalysis(null);
            }}
            placeholder="Type what is bothering you right now... (Example: 'I feel completely stuck and I don't know what to do next...')"
            rows={5}
            className={`w-full p-4 rounded-2xl border border-stone-200 text-stone-800 text-sm leading-relaxed placeholder:text-stone-400 focus:outline-hidden focus:ring-2 focus:ring-emerald-700/20 focus:border-emerald-700 transition-all ${
              isDissolving ? 'opacity-0 scale-95 blur-sm filter transition-all duration-1000' : 'opacity-100'
