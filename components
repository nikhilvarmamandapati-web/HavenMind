      TweenSequenceItem(tween: ConstantTween(0.85), weight: 25),
    ]).animate(_controller);

    _controller.addListener(() {
      final value = _controller.value;
      String nextPhase;
      String nextHint;
      if (value < 0.25) {
        nextPhase = 'Inhale';
        nextHint = 'Breathe in slowly through your nose...';
