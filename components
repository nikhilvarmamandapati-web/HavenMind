export function SilentPresence() {
  const [breathingPhase, setBreathingPhase] = useState<'Inhale' | 'Hold' | 'Exhale' | 'Rest'>('Inhale');
  const [phaseSecondsLeft, setPhaseSecondsLeft] = useState<number>(4);
  const [technique, setTechnique] = useState<'box' | 'relax'>('box');
  const [isPlayingAudio, setIsPlayingAudio] = useState<boolean>(false);
  const [soundTrack, setSoundTrack] = useState<'forest_dawn' | 'theta_waves' | 'rain_mist' | 'singing_bowl_drone'>('theta_waves');
  const [ripples, setRipples] = useState<PresenceRipple[]>([]);
  const [souls, setSouls] = useState<SilentPresenceSoul[]>(INITIAL_SOULS);
  const [warmthSentCount, setWarmthSentCount] = useState<number>(142);

  // Breathing loop
  useEffect(() => {
    const cycleDurations = technique === 'box' 
      ? { Inhale: 4, Hold: 4, Exhale: 4, Rest: 4 }
      : { Inhale: 4, Hold: 7, Exhale: 8, Rest: 2 };

    const interval = setInterval(() => {
      setPhaseSecondsLeft((prev) => {
        if (prev > 1) {
          return prev - 1;
        } else {
          // Advance phase
          setBreathingPhase((curr) => {
            if (curr === 'Inhale') {
              soundEngine.playSingingBowl(380, 2);
              return 'Hold';
            }
            if (curr === 'Hold') {
              return 'Exhale';
            }
            if (curr === 'Exhale') {
              soundEngine.playSingingBowl(432, 2.5);
              return 'Rest';
            }
            soundEngine.playSingingBowl(528, 2);
            return 'Inhale';
          });
          const nextPhase =
            breathingPhase === 'Inhale' ? 'Hold' :
            breathingPhase === 'Hold' ? 'Exhale' :
            breathingPhase === 'Exhale' ? 'Rest' : 'Inhale';
          return cycleDurations[nextPhase];
        }
      });
    }, 1000);

    return () => clearInterval(interval);
  }, [technique, breathingPhase]);

  // Clean old ripples after 4 seconds
  useEffect(() => {
    if (ripples.length === 0) return;
    const timeout = setTimeout(() => {
      setRipples((prev) => prev.filter((r) => Date.now() - r.timestamp < 4000));
    }, 1000);
    return () => clearTimeout(timeout);
