  if (!isOpen) return null;

  const steps = [
    {
      count: 5,
      sense: 'SEE',
      prompt: 'Acknowledge 5 things you see around you right now.',
      hint: 'Look for subtle details: a speck of dust, pattern on the floor, texture on a wall, shade of green.',
      icon: Eye,
      color: 'text-emerald-700 bg-emerald-50',
    },
    {
      count: 4,
      sense: 'TOUCH',
      prompt: 'Acknowledge 4 things you can physically feel.',
      hint: 'Your feet on the ground, clothing against your skin, cold water in a glass, weight of your hands.',
      icon: Hand,
      color: 'text-amber-700 bg-amber-50',
    },
    {
      count: 3,
      sense: 'HEAR',
      prompt: 'Acknowledge 3 things you can hear right now.',
      hint: 'Distant traffic, hum of a fan, your own breath, clock ticking.',
      icon: Volume2,
      color: 'text-sky-700 bg-sky-50',
