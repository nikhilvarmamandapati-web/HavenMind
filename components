import { useState } from 'react';
import { Heart, MessageSquare, Shield, Sparkles, Filter, AlertCircle, HelpCircle } from 'lucide-react';
import { soundEngine } from '../services/soundEngine';
import { CommunityPost, EmotionalBandwidth, PostIntent } from '../types';

interface CommunityFeedProps {
  posts: CommunityPost[];
  bandwidth: EmotionalBandwidth;
  setBandwidth: (b: EmotionalBandwidth) => void;
  onReact: (postId: string, reactionType: 'holdingSpace' | 'gentleHug' | 'iHearYou' | 'inspired') => void;
  onAddComment: (postId: string, commentText: string) => void;
  onOpenNewPostModal: () => void;
}

export function CommunityFeed({
  posts,
  bandwidth,
  setBandwidth,
  onReact,
  onAddComment,
  onOpenNewPostModal,
}: CommunityFeedProps) {
  const [selectedIntentFilter, setSelectedIntentFilter] = useState<string>('all');
  const [revealedSensitives, setRevealedSensitives] = useState<{ [postId: string]: boolean }>({});
  const [activeCommentPostId, setActiveCommentPostId] = useState<string | null>(null);
  const [commentInput, setCommentInput] = useState<string>('');

  const toggleRevealSensitive = (postId: string) => {
    setRevealedSensitives((prev) => ({ ...prev, [postId]: !prev[postId] }));
  };

  const handleSendComment = (post: CommunityPost) => {
    if (!commentInput.trim()) return;
    onAddComment(post.id, commentInput.trim());
    soundEngine.playPebbleDrop();
    setCommentInput('');
    setActiveCommentPostId(null);
  };

  const filteredPosts = posts.filter((post) => {
    if (selectedIntentFilter === 'all') return true;
    return post.intent === selectedIntentFilter;
  });

  return (
    <div className="space-y-6">
      {/* Friendly Guide Box */}
      <div className="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-stone-800 flex items-start gap-3">
        <HelpCircle className="w-5 h-5 text-emerald-700 shrink-0 mt-0.5" />
        <div className="space-y-1">
          <h4 className="text-sm font-bold text-emerald-950">How this community works:</h4>
          <p className="text-xs text-emerald-900 leading-relaxed">
            This is a quiet, kind space to read real stories. Every post clearly says what the author needs (like <em>"Just listen, no advice"</em> or <em>"Advice welcome"</em>), so you always know how to respond kindly.
          </p>
        </div>
      </div>

      {/* Filter and Comfort Controls */}
      <div className="p-5 sm:p-6 rounded-3xl bg-white border border-stone-200 shadow-xs space-y-4">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span className="text-xs font-semibold uppercase tracking-wider text-emerald-800">
              Community Filter
            </span>
            <h2 className="text-lg sm:text-xl font-bold text-stone-900 mt-0.5">
              Comfort Level: Hide Heavy Topics?
            </h2>
            <p className="text-xs text-stone-600 mt-0.5">
              If you are having a tough day, pick "Gentle Mode" to blur out painful stories.
            </p>
          </div>

          {/* Simple 3-step Comfort Mode Switcher */}
          <div className="flex items-center gap-1.5 p-1 bg-stone-100 rounded-xl self-start sm:self-auto border border-stone-200">
            <button
              onClick={() => {
                setBandwidth('low');
                soundEngine.playPebbleDrop();
              }}
              className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-colors ${
                bandwidth === 'low'
                  ? 'bg-emerald-800 text-white shadow-xs font-bold'
                  : 'text-stone-600 hover:text-stone-900'
              }`}
            >
              🛡️ Gentle Mode (Hide Triggers)
            </button>
            <button
              onClick={() => {
                setBandwidth('balanced');
                soundEngine.playPebbleDrop();
              }}
              className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-colors ${
                bandwidth === 'balanced'
                  ? 'bg-emerald-800 text-white shadow-xs font-bold'
                  : 'text-stone-600 hover:text-stone-900'
              }`}
            >
              Balanced Mode
            </button>
          </div>
        </div>

        {/* Filter by what people need */}
        <div className="pt-3 border-t border-stone-100 flex flex-wrap items-center justify-between gap-3">
          <div className="flex flex-wrap items-center gap-1.5">
            <span className="text-xs font-medium text-stone-500 mr-1 flex items-center gap-1">
              <Filter className="w-3.5 h-3.5" />
              <span>Show:</span>
            </span>

            {[
              { id: 'all', label: 'All Stories' },
              { id: 'Needs Gentle Listening', label: 'Just Listening' },
              { id: 'Validation Only - No Advice', label: 'No Advice Please' },
              { id: 'Solution-Oriented Advice Welcome', label: 'Advice Welcome' },
              { id: 'Celebrating Small Win', label: 'Small Wins' },
            ].map((f) => (
              <button
                key={f.id}
                onClick={() => setSelectedIntentFilter(f.id)}
                className={`px-2.5 py-1 text-xs rounded-lg transition-colors ${
                  selectedIntentFilter === f.id
                    ? 'bg-stone-900 text-white font-medium shadow-xs'
                    : 'bg-stone-100 hover:bg-stone-200 text-stone-700'
                }`}
              >
                {f.label}
              </button>
            ))}
          </div>

          <button
            onClick={onOpenNewPostModal}
            className="px-4 py-2 bg-emerald-800 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-xs transition-colors flex items-center gap-1.5"
          >
            <Sparkles className="w-3.5 h-3.5 text-emerald-300" />
            <span>Write a Story</span>
          </button>
        </div>
      </div>

      {/* Stories List */}
      <div className="space-y-4">
        {filteredPosts.map((post) => {
          const isTriggerShielded =
            post.isSensitive && bandwidth === 'low' && !revealedSensitives[post.id];

          return (
            <article
              key={post.id}
              className="p-6 rounded-3xl bg-white border border-stone-200 shadow-xs space-y-4 transition-all"
            >
              {/* Card Header: Title & Clean unboxed metadata */}
              <div className="space-y-1.5">
                {post.title && (
                  <h3 className="text-base sm:text-lg font-bold text-stone-900 leading-snug">
                    {post.title}
                  </h3>
                )}

                <div className="flex flex-wrap items-center gap-2 text-xs text-stone-500">
                  <span className="font-semibold text-stone-800">{post.author.pseudonym}</span>
                  <span aria-hidden="true">·</span>
                  <span className="text-emerald-800 font-medium">Looking for: {post.intent}</span>
                  <span aria-hidden="true">·</span>
                  <span>{post.timeAgo}</span>
                  {post.isSensitive && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span className="text-amber-800 font-medium">Contains heavy topic</span>
                    </>
                  )}
                </div>
              </div>

              {/* Shielded State for Gentle Mode */}
              {isTriggerShielded ? (
                <div className="p-5 rounded-2xl bg-amber-50 border border-amber-200 text-center space-y-2">
                  <Shield className="w-5 h-5 text-amber-700 mx-auto" />
                  <div className="text-xs font-bold text-amber-900">
                    Story Hidden in Gentle Mode
                  </div>
                  <p className="text-xs text-amber-800 max-w-md mx-auto">
                    {post.sensitiveNotice || 'This story talks about deep panic, grief, or burnout.'}
                  </p>
                  <button
                    onClick={() => toggleRevealSensitive(post.id)}
                    className="mt-2 px-3.5 py-1.5 rounded-lg bg-white border border-amber-300 text-amber-950 text-xs font-semibold hover:bg-amber-100 transition-colors"
                  >
                    Click to Read (I feel ready)
                  </button>
                </div>
              ) : (
                <div className="space-y-3">
                  <p className="text-sm text-stone-700 leading-relaxed whitespace-pre-line">
                    {post.content}
                  </p>

                  {post.pinnedKindnessQuote && (
                    <div className="p-3 rounded-xl bg-stone-50 border border-stone-200 text-xs text-stone-600 italic">
                      "{post.pinnedKindnessQuote}"
                    </div>
                  )}
                </div>
              )}

              {/* Empathy Action Buttons */}
              <div className="pt-3 border-t border-stone-100 flex flex-wrap items-center justify-between gap-3">
                <div className="flex flex-wrap items-center gap-2">
                  <button
                    onClick={() => {
                      onReact(post.id, 'holdingSpace');
                      soundEngine.playPebbleDrop();
                    }}
                    className="px-3 py-1.5 rounded-xl bg-stone-50 hover:bg-emerald-50 border border-stone-200 hover:border-emerald-300 text-xs text-stone-700 hover:text-emerald-900 transition-colors flex items-center gap-1.5"
                    title="Send silent support"
                  >
                    <span>🤲 I'm With You</span>
                    <span className="font-mono tabular-nums text-stone-500 font-semibold">
                      {post.reactions.holdingSpace}
                    </span>
                  </button>

                  <button
                    onClick={() => {
                      onReact(post.id, 'gentleHug');
                      soundEngine.playPebbleDrop();
                    }}
                    className="px-3 py-1.5 rounded-xl bg-stone-50 hover:bg-rose-50 border border-stone-200 hover:border-rose-300 text-xs text-stone-700 hover:text-rose-900 transition-colors flex items-center gap-1.5"
                    title="Send a warm virtual hug"
                  >
                    <span>🫂 Sending Hug</span>
                    <span className="font-mono tabular-nums text-stone-500 font-semibold">
                      {post.reactions.gentleHug}
                    </span>
                  </button>

                  <button
                    onClick={() => {
                      onReact(post.id, 'iHearYou');
                      soundEngine.playPebbleDrop();
                    }}
                    className="px-3 py-1.5 rounded-xl bg-stone-50 hover:bg-sky-50 border border-stone-200 hover:border-sky-300 text-xs text-stone-700 hover:text-sky-900 transition-colors flex items-center gap-1.5"
                    title="Let them know they were heard"
                  >
                    <span>👂 I Hear You</span>
                    <span className="font-mono tabular-nums text-stone-500 font-semibold">
                      {post.reactions.iHearYou}
                    </span>
                  </button>
                </div>

                <button
                  onClick={() =>
                    setActiveCommentPostId(activeCommentPostId === post.id ? null : post.id)
                  }
                  className="text-xs font-semibold text-stone-600 hover:text-stone-900 flex items-center gap-1.5"
                >
                  <MessageSquare className="w-3.5 h-3.5" />
                  <span>{post.comments.length} Friendly Replies</span>
                </button>
              </div>

              {/* Replies Section */}
              {activeCommentPostId === post.id && (
                <div className="pt-4 border-t border-stone-100 space-y-4 animate-in fade-in">
                  <div className="p-3 rounded-xl bg-stone-50 border border-stone-200 flex items-start gap-2 text-xs text-stone-600">
                    <AlertCircle className="w-4 h-4 text-emerald-700 shrink-0 mt-0.5" />
                    <div>
                      <span className="font-bold text-stone-800">
                        Reminder: {post.author.pseudonym} asked for: "{post.intent}".
                      </span>{' '}
                      {post.intent === 'Validation Only - No Advice'
                        ? 'Please do not tell them how to fix it—just tell them you understand and care.'
                        : 'Share your warm words or gentle advice.'}
                    </div>
                  </div>

                  {/* Comments list */}
                  <div className="space-y-3">
                    {post.comments.map((comment) => (
                      <div
                        key={comment.id}
                        className="p-3.5 rounded-2xl bg-stone-50 border border-stone-200 space-y-1"
                      >
                        <div className="flex items-center justify-between text-xs text-stone-500">
                          <span className="font-bold text-stone-800">
                            {comment.author.pseudonym}
                          </span>
                          <span>{comment.createdAt}</span>
                        </div>
                        <p className="text-xs sm:text-sm text-stone-700 leading-relaxed">
                          {comment.content}
                        </p>
                      </div>
                    ))}
                  </div>

                  {/* Add comment input */}
                  <div className="flex items-center gap-2">
                    <input
                      type="text"
                      value={commentInput}
                      onChange={(e) => setCommentInput(e.target.value)}
                      placeholder="Write a kind, encouraging reply..."
                      className="flex-1 px-4 py-2 text-xs sm:text-sm bg-white border border-stone-300 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-emerald-700/20"
                      onKeyDown={(e) => {
                        if (e.key === 'Enter') handleSendComment(post);
                      }}
                    />
                    <button
                      onClick={() => handleSendComment(post)}
                      className="px-4 py-2 bg-emerald-800 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow-xs transition-colors"
                    >
                      Reply
                    </button>
                  </div>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </div>
  );
}
