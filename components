      prompt: 'Acknowledge 2 things you can smell or enjoy.',
      hint: 'Coffee, fabric softener, fresh air from a window, or simply imagine the scent of pine needles.',
      icon: Sparkles,
      color: 'text-indigo-700 bg-indigo-50',
    },
    {
      count: 1,
      sense: 'TASTE',
      prompt: 'Acknowledge 1 thing you can taste, or take a cool sip of water.',
      hint: 'The lingering taste of mint, tea, or swallow saliva and feel your throat gently relax.',
      icon: Heart,
      color: 'text-rose-700 bg-rose-50',
    },
  ];

  const handleStepComplete = () => {
    soundEngine.playSingingBowl(528, 2);
    if (currentStep < steps.length - 1) {
      setCurrentStep(currentStep + 1);
    } else {
      // Completed all 5 steps
      const newChecked = [...checkedItems];
      newChecked[currentStep] = true;
      setCheckedItems(newChecked);
    }
  };

  const handleReset = () => {
    setCurrentStep(0);
    setCheckedItems([false, false, false, false, false]);
  };

  const activeStepData = steps[currentStep];
