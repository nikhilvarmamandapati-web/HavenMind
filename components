              <p className="text-xs text-stone-500">A quick exercise to bring you back when feeling panicky or overwhelmed</p>
            </div>
          </div>
          <button
            onClick={onClose}
            aria-label="Close grounding modal"
            className="w-9 h-9 rounded-full flex items-center justify-center text-stone-400 hover:text-stone-700 hover:bg-stone-100 transition-colors"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Modal Body */}
        <div className="p-6 overflow-y-auto space-y-6">
          {/* Progress Tracker */}
          <div className="flex items-center justify-between gap-2">
            {steps.map((st, idx) => (
              <button
                key={st.count}
                onClick={() => setCurrentStep(idx)}
                className={`flex-1 py-1.5 px-1 text-center rounded-lg text-xs font-medium transition-all ${
                  idx === currentStep
                    ? 'bg-stone-900 text-white shadow-sm'
                    : idx < currentStep
                    ? 'bg-emerald-100 text-emerald-800'
                    : 'bg-stone-100 text-stone-500 hover:bg-stone-200'
                }`}
              >
                {st.count} {st.sense}
              </button>
            ))}
          </div>

          {/* Current Step Card */}
          <div className="p-5 rounded-2xl bg-stone-50 border border-stone-200/80 space-y-4">
            <div className="flex items-start gap-4">
              <div className={`w-12 h-12 rounded-2xl flex items-center justify-center shrink-0 ${activeStepData.color}`}>
                <StepIcon className="w-6 h-6" />
              </div>
              <div className="space-y-1">
                <span className="text-xs font-semibold tracking-wider text-emerald-800 uppercase">
                  Step {currentStep + 1} of 5
                </span>
                <h3 className="text-lg font-semibold text-stone-900">{activeStepData.prompt}</h3>
                <p className="text-sm text-stone-600 leading-relaxed">{activeStepData.hint}</p>
              </div>
            </div>

            <div className="pt-2 flex items-center justify-between">
              <button
                onClick={handleStepComplete}
