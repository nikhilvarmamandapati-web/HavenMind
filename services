class CognitiveReframerService {
  static List<DistortionResult> analyzeThought(String rawText) {
    final text = rawText.toLowerCase();
    final results = <DistortionResult>[];

    if (text.contains('always') ||
        text.contains('never') ||
        text.contains('failure') ||
        text.contains('worthless') ||
        text.contains('ruined')) {
      results.add(DistortionResult(
        name: 'All-or-Nothing Extremes',
        explanation: 'Seeing things in absolute black-or-white terms without room for progress.',
        gentleReframe: 'Emotions are intense right now, but situations are rarely all-or-nothing. Even small steps count.',
      ));
    }

    if (text.contains('disaster') ||
        text.contains('end of the world') ||
        text.contains('unbearable') ||
        text.contains('cannot survive') ||
        text.contains('worst')) {
      results.add(DistortionResult(
        name: 'Expecting the Worst (Catastrophizing)',
        explanation: 'Anticipating total catastrophe before things even happen.',
        gentleReframe: 'Your nervous system is on high alert. Take a slow exhale; you have made it through 100% of your hard days so far.',
      ));
    }

    if (text.contains('should have') ||
        text.contains('must be') ||
        text.contains('supposed to be')) {
      results.add(DistortionResult(
        name: 'Harsh "Should" Rules',
        explanation: 'Holding yourself to rigid rules that cause guilt and shame.',
        gentleReframe: 'Replace "I should" with "I am doing the best I can with the energy I have today."',
      ));
    }

    return results;
  }
}
import { CognitiveDistortionMatch } from '../types';

interface DistortionPattern {
  name: string;
  triggers: RegExp[];
  explanation: string;
  generateReframe: (snippet: string) => string;
}

const DISTORTION_PATTERNS: DistortionPattern[] = [
  {
    name: 'All-or-Nothing Thinking',
    triggers: [
      /\b(always|never|completely|ruined|total failure|everyone hates|nobody cares|worthless)\b/i,
      /\b(everything goes wrong|can't do anything right)\b/i,
    ],
    explanation: 'Seeing things in absolute extremes with no room for nuance, shades of grey, or humane learning.',
    generateReframe: (snippet) =>
      `While it hurts right now, life rarely operates in extremes. Not everything is broken—even small steps count, and this moment doesn't define your entire journey.`
  },
  {
    name: 'Catastrophizing',
    triggers: [
      /\b(end of the world|can't survive this|worst thing ever|nightmare|everything is collapsing)\b/i,
      /\b(what if.*disaster|unbearable)\b/i,
    ],
    explanation: 'Anticipating the absolute worst possible outcome and believing you lack the strength to handle it.',
    generateReframe: (snippet) =>
      `The panic feels very real right now, but your nervous system is amplifying the danger. You have weathered difficult days before and you can take this one breath at a time.`
  },
  {
    name: '"Should" & "Must" Demands',
    triggers: [
      /\b(i should have|i must be|i shouldn't feel|ought to be further|i should be happy)\b/i,
      /\b(i shouldn't be struggling|supposed to be)\b/i,
    ],
    explanation: 'Holding yourself to rigid, punishing internal rules that breed guilt and self-blame.',
    generateReframe: (snippet) =>
      `Give yourself permission to replace "I should" with "I am doing the best I can with the energy I currently have." Self-compassion heals faster than self-criticism.`
  },
  {
    name: 'Emotional Reasoning',
    triggers: [
      /\b(i feel like a burden|i feel like a fraud|i feel disgusting|i feel hopeless so it is)\b/i,
      /\b(feels like nobody wants me)\b/i,
    ],
    explanation: 'Assuming that because you feel overwhelmed or inadequate, that emotion represents objective reality.',
    generateReframe: (snippet) =>
      `Emotions are heavy weather systems, but they are not facts. Feeling like a burden does not mean you are one. You are allowed to take up space and ask for support.`
  },
  {
    name: 'Fortune Telling / Mind Reading',
    triggers: [
      /\b(i know they think|they are definitely judging|it will never get better|i know what will happen)\b/i,
      /\b(they probably hate me|they regret talking to me)\b/i,
    ],
    explanation: 'Assuming you know others\' negative thoughts or predicting a bleak outcome without evidence.',
    generateReframe: (snippet) =>
      `You cannot read minds, and people are often wrapped in their own insecurities. Give yourself the benefit of the doubt rather than assuming rejection.`
  }
];

export function analyzeVentThought(text: string): {
  distortions: CognitiveDistortionMatch[];
  reframeSummary: string;
} {
  const trimmed = text.trim();
  if (!trimmed) {
    return {
      distortions: [],
      reframeSummary: 'Share whatever is weighing heavy on your chest. We are here to help untangle it softly.'
    };
  }

  const detected: CognitiveDistortionMatch[] = [];

  for (const pattern of DISTORTION_PATTERNS) {
    for (const regex of pattern.triggers) {
      const match = trimmed.match(regex);
      if (match) {
        // extract context
        const index = match.index || 0;
        const start = Math.max(0, index - 25);
        const end = Math.min(trimmed.length, index + match[0].length + 25);
        const snippet = (start > 0 ? '...' : '') + trimmed.slice(start, end) + (end < trimmed.length ? '...' : '');

        detected.push({
          name: pattern.name,
          detectedQuote: `"${match[0]}" in "${snippet}"`,
          explanation: pattern.explanation,
          gentleReframe: pattern.generateReframe(snippet),
        });
        break; // one match per category
      }
    }
  }

  // Generate holistic empathetic reframe
  let reframeSummary = '';
  if (detected.length === 0) {
    reframeSummary =
      'Your feelings are completely valid. It takes bravery to articulate this weight. Remember that expressing your pain is the first step toward releasing its grip on your nervous system.';
  } else {
    reframeSummary =
      `Notice how your anxious mind is using ${detected.map(d => d.name).join(' and ')} to magnify this pain. You don't have to believe every alarm bell your tired mind rings. You are worthy of gentleness today.`;
  }

  return {
    distortions: detected,
    reframeSummary
  };
}
class SoundEngine {
  private ctx: AudioContext | null = null;
  private isMuted: boolean = false;
  private activeNodes: { [key: string]: AudioNode[] } = {};
  private currentTrack: string | null = null;

  private initCtx() {
    if (!this.ctx) {
      const AudioCtxClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      this.ctx = new AudioCtxClass();
    }
    if (this.ctx.state === 'suspended') {
      this.ctx.resume();
    }
  }

  // Play a gentle singing bowl chime with harmonics
  public playSingingBowl(freq = 432, duration = 3.5) {
    try {
      this.initCtx();
      if (!this.ctx || this.isMuted) return;

      const now = this.ctx.currentTime;
      const fundamental = this.ctx.createOscillator();
      const overtone1 = this.ctx.createOscillator();
      const overtone2 = this.ctx.createOscillator();
      const masterGain = this.ctx.createGain();

      fundamental.type = 'sine';
      fundamental.frequency.setValueAtTime(freq, now);

      overtone1.type = 'sine';
      overtone1.frequency.setValueAtTime(freq * 2.76, now); // Tibetan bowl harmonic ratio

      overtone2.type = 'sine';
      overtone2.frequency.setValueAtTime(freq * 5.4, now);

      const gain1 = this.ctx.createGain();
      gain1.gain.setValueAtTime(0.35, now);
      gain1.gain.exponentialRampToValueAtTime(0.0001, now + duration);

      const gain2 = this.ctx.createGain();
      gain2.gain.setValueAtTime(0.12, now);
      gain2.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.7);

      const gain3 = this.ctx.createGain();
      gain3.gain.setValueAtTime(0.05, now);
      gain3.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.4);

      masterGain.gain.setValueAtTime(0.4, now);

      fundamental.connect(gain1);
      overtone1.connect(gain2);
      overtone2.connect(gain3);

      gain1.connect(masterGain);
      gain2.connect(masterGain);
      gain3.connect(masterGain);

      masterGain.connect(this.ctx.destination);

      fundamental.start(now);
      overtone1.start(now);
      overtone2.start(now);

      fundamental.stop(now + duration);
      overtone1.stop(now + duration);
      overtone2.stop(now + duration);
    } catch {
      // AudioContext could be blocked if no user gesture yet
    }
  }

  // Play a soft water drop or pebble ripple sound
  public playPebbleDrop() {
    try {
      this.initCtx();
      if (!this.ctx || this.isMuted) return;

      const now = this.ctx.currentTime;
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();

      osc.type = 'sine';
      osc.frequency.setValueAtTime(600, now);
      osc.frequency.exponentialRampToValueAtTime(950, now + 0.08);
      osc.frequency.exponentialRampToValueAtTime(500, now + 0.25);

      gain.gain.setValueAtTime(0.18, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);

      osc.connect(gain);
      gain.connect(this.ctx.destination);

      osc.start(now);
      osc.stop(now + 0.35);
    } catch {
      // Fallback silent
    }
  }

  // Continuous ambient generators
  public startAmbiance(type: 'forest_dawn' | 'theta_waves' | 'rain_mist' | 'singing_bowl_drone') {
    this.stopAmbiance();
    try {
      this.initCtx();
      if (!this.ctx) return;
      this.currentTrack = type;

      const nodes: AudioNode[] = [];
      const now = this.ctx.currentTime;

      if (type === 'theta_waves') {
        // Binaural 432Hz & 438Hz (6Hz Theta wave for deep calm & emotional release)
        const leftOsc = this.ctx.createOscillator();
        const rightOsc = this.ctx.createOscillator();
        const leftPanner = this.ctx.createStereoPanner ? this.ctx.createStereoPanner() : null;
        const rightPanner = this.ctx.createStereoPanner ? this.ctx.createStereoPanner() : null;
        const gain = this.ctx.createGain();

        leftOsc.type = 'sine';
        leftOsc.frequency.setValueAtTime(216, now); // Soft sub-harmonic

        rightOsc.type = 'sine';
        rightOsc.frequency.setValueAtTime(222, now); // 6Hz theta difference

        gain.gain.setValueAtTime(0.001, now);
        gain.gain.linearRampToValueAtTime(0.12, now + 2);

        if (leftPanner && rightPanner) {
          leftPanner.pan.setValueAtTime(-0.8, now);
          rightPanner.pan.setValueAtTime(0.8, now);
          leftOsc.connect(leftPanner);
          rightOsc.connect(rightPanner);
          leftPanner.connect(gain);
          rightPanner.connect(gain);
          nodes.push(leftPanner, rightPanner);
        } else {
          leftOsc.connect(gain);
          rightOsc.connect(gain);
        }

        gain.connect(this.ctx.destination);
        leftOsc.start(now);
        rightOsc.start(now);

        nodes.push(leftOsc, rightOsc, gain);
      } else if (type === 'rain_mist' || type === 'forest_dawn') {
        // Pink noise buffer simulation for rainfall & rustling leaves
        const bufferSize = this.ctx.sampleRate * 2;
        const noiseBuffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const output = noiseBuffer.getChannelData(0);
        let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;
        for (let i = 0; i < bufferSize; i++) {
          const white = Math.random() * 2 - 1;
          b0 = 0.99886 * b0 + white * 0.0555179;
          b1 = 0.99332 * b1 + white * 0.0750759;
          b2 = 0.96900 * b2 + white * 0.1538520;
          b3 = 0.86650 * b3 + white * 0.3104856;
          b4 = 0.55000 * b4 + white * 0.5329522;
          b5 = -0.7616 * b5 - white * 0.0168980;
          output[i] = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362) * 0.05;
          b6 = white * 0.115926;
        }

        const whiteNoise = this.ctx.createBufferSource();
        whiteNoise.buffer = noiseBuffer;
        whiteNoise.loop = true;

        const filter = this.ctx.createBiquadFilter();
        filter.type = type === 'rain_mist' ? 'lowpass' : 'bandpass';
        filter.frequency.setValueAtTime(type === 'rain_mist' ? 800 : 500, now);

        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(0.001, now);
        gain.gain.linearRampToValueAtTime(0.08, now + 1.5);

        whiteNoise.connect(filter);
        filter.connect(gain);
        gain.connect(this.ctx.destination);

        whiteNoise.start(now);
        nodes.push(whiteNoise, filter, gain);
      } else {
        // Drone harmonic
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(136.1, now); // Om frequency / Earth frequency
        gain.gain.setValueAtTime(0.001, now);
        gain.gain.linearRampToValueAtTime(0.09, now + 2);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        nodes.push(osc, gain);
      }

      this.activeNodes[type] = nodes;
    } catch {
      // Audio engine quiet fallback
    }
  }

  public stopAmbiance() {
    if (this.ctx) {
      Object.keys(this.activeNodes).forEach((k) => {
        this.activeNodes[k].forEach((node) => {
          try {
            if ('stop' in node && typeof (node as AudioScheduledSourceNode).stop === 'function') {
              (node as AudioScheduledSourceNode).stop();
            }
            node.disconnect();
          } catch {
            // Ignore stop errors
          }
        });
      });
      this.activeNodes = {};
      this.currentTrack = null;
    }
  }

  public isPlaying(): boolean {
    return this.currentTrack !== null;
  }

  public getCurrentTrack(): string | null {
    return this.currentTrack;
  }
}

export const soundEngine = new SoundEngine();

